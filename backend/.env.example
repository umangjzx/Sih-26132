DATABASE_URL=postgresql+psycopg2://agrilink:agrilink@localhost:5433/agrilink
DATA_GOV_IN_API_KEY=
# off by default - no live arrivals source in Phase 1, see PRICE-07
ARRIVALS_SOURCE_URL=
# shared secret for POST /api/ingest/run; blank disables the endpoint
INGEST_TRIGGER_SECRET=
CORS_ORIGINS=http://localhost:3000

# Phase 2: JWT auth — set JWT_SECRET_KEY to a long random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_TTL_SECONDS=600
# demo build: also return the OTP in the /auth/otp/request response. Set false in production.
EXPOSE_OTP=true

# v1.1: indicative road-freight cost, rupees per quintal per km
TRANSPORT_COST_PER_QTL_KM=0.4
# v1.2: optional OpenWeatherMap key. Set it to enrich the 7-day forecast
# with current conditions (humidity, feels-like). Blank -> keyless Open-Meteo only.
WEATHER_API_KEY=

# v1.2: which AGMARKNET states the scheduled ingestion pulls.
# Comma-separated (e.g. "Maharashtra,Karnataka"), or "ALL" for the whole national feed.
INGEST_STATES=Maharashtra
# free keyless reverse-geocoder (lat/lon -> state + district)
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
